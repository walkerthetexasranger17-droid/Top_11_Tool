  const fast=xi();set(fast,['st','aml','amr'],['Speed','Dribbling','Passing','Finishing','Positioning'],185);fast.find(x=>x.key==='st').playstyle={type:'Poacher',level:3};fast.find(x=>x.key==='aml').playstyle={type:'Inside Forward',level:3};fast.find(x=>x.key==='amr').playstyle={type:'Inside Forward',level:3};
