p=xi();set(p,['st'],['Heading','Strength','Positioning'],180);set(p,['aml','amr'],['Crossing','Speed','Dribbling'],170);r=run(p);ok(r.values.focus==='both','Symmetric elite wings did not select Both Flanks');ok(r.values.cross==='high','Aerial-wide XI did not select High Crosses');
// Low pressing-capacity XI should keep the deep regroup package; the gate must not erase the legitimate low-intensity style.
{
  const low=xi();set(low,low.filter(x=>x.key!=='gk').map(x=>x.key),['Fitness','Aggression','Tackling','Bravery','Speed'],60);set(low,['dl','dc1','dc2','dr','dmc'],['Marking','Positioning'],180);const lr=run(low);ok(lr.contextFit.own.pressCapacity==='low','Low-press fixture did not create low press capacity');ok(lr.values.pressing==='low'&&lr.values.lost==='regroup','Low press-capacity XI lost the Low Block + Regroup package');
