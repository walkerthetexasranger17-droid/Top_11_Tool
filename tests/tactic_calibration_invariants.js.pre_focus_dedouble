// Left/right mirror invariance: exact mirrors must retain score and swap only directional focus when one side is genuinely dominant.
const leftMirror=xi();set(leftMirror,['dl','aml'],['Passing','Creativity','Dribbling','Crossing','Shooting','Finishing','Speed'],190);const lm=run(leftMirror);
const roleMirror={DL:'DR',DR:'DL',ML:'MR',MR:'ML',AML:'AMR',AMR:'AML'};
const rightMirror=leftMirror.map(p=>{const role=roleMirror[p.roles[0]]||p.roles[0];return{...p,key:'m_'+p.key,position:role,roles:[role],skills:{...p.skills}};});const rm=run(rightMirror);
