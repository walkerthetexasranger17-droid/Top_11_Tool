const fs=require('fs'),vm=require('vm'),path=require('path');global.window=global;global.localStorage={getItem(){return null},setItem(){},removeItem(){},key(){return null},get length(){return 0}};
const ROOT=path.join(__dirname,'..');for(const f of ['optimizer-data.js','bible-data.js','data.js','strategy-data.js','strategy-logic.js','formation.js','tactics-engine.js'])vm.runInThisContext(fs.readFileSync(path.join(ROOT,'js',f),'utf8'),{filename:f});
const {Data:D,Formation:F,Tactics:T}=TE5,A=Object.keys(D.ATTRIBUTE_IDS);let failures=[],assertions=0;function ok(c,m){assertions++;if(!c)failures.push(m)}
function mk(k,r,v=100,ps=null){return{key:k,name:k,position:r,roles:[r],relatedRoles:[],ovr:v,skills:Object.fromEntries(A.map(a=>[a,v])),specialAbilities:[],playstyle:ps?{type:ps,level:3}:null}}
function xi(){return [['gk','GK'],['dl','DL'],['dc1','DC'],['dc2','DC'],['dr','DR'],['dmc','DMC'],['mc','MC'],['aml','AML'],['amc','AMC'],['amr','AMR'],['st','ST']].map(x=>mk(...x));}
function set(players,keys,skills,val){for(const p of players.filter(p=>keys.includes(p.key)))for(const a of skills)p.skills[a]=val;}
function run(players){const starters=F.assign(players,F.FORMATIONS.find(x=>x.id==='41131')).chosen;const r=T.recommendAuto(starters,{drainLimit:'High',drainProfile:T.DRAIN_PROFILE_LIVE});ok(!r.error,'Tactic calibration fixture returned error '+r.error);ok(r.drainProfile===T.DRAIN_PROFILE_LIVE,'Fixture did not use live-observed drain profile');ok(r.rawScore===null&&r.relativeScore===null&&r.normalized===null,'Live profile fabricated a numeric drain total');ok(Number.isInteger(r.mediumCount)&&Number.isInteger(r.highCount),'Live profile did not expose categorical intensity counts');ok(r.drainClass==='Unclassified','Live drain class was guessed without mixed-intensity weights');return r;}
// Neutral own-squad evidence should use the declared neutral defaults rather than receiving free extreme-style coherence.
{
  const n=run(xi());ok(n.values.passing==='mixed','Neutral XI did not select Mixed Passing after strong-style coherence gating');ok(n.values.won==='buildup','Neutral XI did not retain Buildup as the neutral possession-won choice');ok(n.values.pressing==='mid','Medium pressing-capacity XI did not select Mid Press after extreme pair bonuses were gated');
}
// Technical midfield/attack: short circulation and buildup must be preferred when those clusters are overwhelmingly strong.
let p=xi();set(p,['dmc','mc','aml','amc','amr'],['Passing','Creativity','Dribbling'],170);let r=run(p);ok(r.values.passing==='short','Technical XI did not select Short Passing');ok(r.values.won==='buildup','Technical XI did not select Focus on Buildup');
