const base=xi(),a=run(base);const tiny=xi();tiny.find(x=>x.key==='aml').skills.Dribbling+=0.001;const b=run(tiny);ok(JSON.stringify(a.values)===JSON.stringify(b.values),'A +0.001 relevant skill perturbation flipped the tactic plan');ok(Math.abs(a.decisionScore-b.decisionScore)<0.01,'A +0.001 perturbation created an excessive tactic-score jump');

// Filtered metric fallback must never borrow unrelated XI players. A narrow shape with no wide-role starter has zero WideAttack support rather than inheriting central-player skills.
{
  const narrowRoles=['GK','DC','DC','DC','DMC','MC','MC','MC','AMC','ST','ST'];
  const narrow=narrowRoles.map((r,i)=>mk(`narrow${i}`,r,100));
  const form={id:'narrow-cal',name:'narrow-cal',slots:narrowRoles,templateOrder:999};
  const assigned=F.assign(narrow,form);
  ok(!assigned.error,'narrow metric fixture could not be assigned');
  const metrics=T.lineupMetrics(assigned.chosen);
  ok(metrics.WideAttack===0,'WideAttack borrowed central players when no wide-role player existed');
}


// Open-play aerial-target support comes from advanced target roles, not centre-backs/screen players.
{
  const p=xi();
  const assigned=F.assign(p,F.FORMATIONS.find(x=>x.id==='41131')).chosen;
  const before=T.lineupMetrics(assigned).AerialTarget;
  for(const s of assigned.filter(x=>['DC','DMC'].includes(x.assignedRole))){s.player.skills.Heading=200;s.player.skills.Strength=200;s.player.skills.Positioning=200;}
  const after=T.lineupMetrics(assigned).AerialTarget;
  ok(Math.abs(after-before)<1e-9,'defensive-role attributes inflated open-play AerialTarget support');
}


