// 3. Full automatic package: five unique penalties and captain auto-filled.
{
 const list=Array.from({length:11},(_,i)=>p(`p${i+1}`,{role:i<4?'DC':i<8?'MC':'ST',ovr:100+i,base:100+i,sa:i===0?['Penalty Kick Specialist']:i===1?['Free Kick Specialist']:i===2?['Corner Specialist']:[]}));
 const plan=R.buildSetPiecePlan(starters(list)),pens=['penalty1','penalty2','penalty3','penalty4','penalty5'].map(k=>plan.assignments[k]);
 ok(pens.every(Boolean),'Automatic package left a penalty slot empty');ok(new Set(pens).size===5,'Automatic penalty hierarchy contains duplicate players');ok(Boolean(plan.assignments.captain),'Automatic package left captain empty');ok(plan.assignments.captain==='p11','Captain convenience default is not highest OVR starter');
}
// 4. Captain is performance-neutral: changing only captain convenience ordering cannot change readiness tie tuple.
{
 const base=[p('a',{ovr:120,base:100}),p('b',{ovr:110,base:100,sa:['Penalty Kick Specialist']}),p('c',{ovr:105,base:100,sa:['Free Kick Specialist']}),p('d',{ovr:100,base:100,sa:['Corner Specialist']})];
 const x=R.buildSetPiecePlan(starters(base)),changed=base.map(z=>({...z,skills:{...z.skills}}));changed[0].ovr=80;changed[3].ovr=140;const y=R.buildSetPiecePlan(starters(changed));
 ok(x.assignments.captain!==y.assignments.captain,'Captain fixture did not actually change captain default');ok(JSON.stringify(x.readiness.tieTuple)===JSON.stringify(y.readiness.tieTuple),'Captain change leaked into Set-Piece readiness/Team Plan tie-break');ok(R.compareReadiness(x,y)===0,'Captain change affected compareReadiness');
}

// 4b. Team-plan readiness preserves dedicated-specialist superiority over generic Set Piece Taker.
{
 const dedicated=[p('pen',{sa:['Penalty Kick Specialist'],base:100}),p('fk',{sa:['Free Kick Specialist'],base:100}),p('corner',{sa:['Corner Specialist'],base:100}),...Array.from({length:8},(_,i)=>p(`d${i}`,{base:100}))];
 const generic=[p('pen',{sa:['Set Piece Taker'],base:100}),p('fk',{sa:['Set Piece Taker'],base:100}),p('corner',{sa:['Set Piece Taker'],base:100}),...Array.from({length:8},(_,i)=>p(`g${i}`,{base:100}))];
 const a=R.buildSetPiecePlan(starters(dedicated)),b=R.buildSetPiecePlan(starters(generic));
 ok(a.readiness.specialistCoverage===3&&b.readiness.specialistCoverage===3,'Dedicated/generic readiness fixture did not preserve equal family coverage');
 ok(a.readiness.specialistTierSum>b.readiness.specialistTierSum,'Dedicated specialist tiers were collapsed into generic Set Piece Taker readiness');
