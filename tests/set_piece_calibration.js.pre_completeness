const {Data:D,Recommendations:R}=global.TE5;let failures=[],assertions=0;
function ok(cond,msg){assertions++;if(!cond)failures.push(msg)}
const attrs=Object.keys(D.ATTRIBUTE_IDS);
function p(key,{role='ST',ovr=100,base=100,sa=[],skills={}}={}){return{key,name:key,position:role,roles:[role],ovr,skills:{...Object.fromEntries(attrs.map(a=>[a,base])),...skills},specialAbilities:sa};}
function e(player,role=player.position){const whites=D.POSITION_WHITE[role]||[],vals=whites.map(a=>Number(player.skills[a])).filter(Number.isFinite);return{player,assignedRole:role,roleMean:vals.length?vals.reduce((a,b)=>a+b,0)/vals.length:0,roleFloor:vals.length?Math.min(...vals):0};}
function starters(list){return list.map(x=>e(x));}
// 1. Real specialist identity is lexicographically first: a moderately weaker specialist must beat a better raw non-specialist.
{
 const spec=p('pen-spec',{ovr:95,base:95,sa:['Penalty Kick Specialist'],skills:{Finishing:95,Shooting:95,Creativity:95}}),raw=p('raw-star',{ovr:110,base:110,skills:{Finishing:110,Shooting:110,Creativity:110}});
 const r=R.rankPenalty(starters([raw,spec]));ok(r[0].player.key==='pen-spec','Penalty specialist did not outrank stronger raw non-specialist');
}
{
 const spec=p('fk-spec',{ovr:95,base:95,sa:['Free Kick Specialist']}),raw=p('raw-star',{ovr:110,base:110});
 const r=R.rankFreeKick(starters([raw,spec]));ok(r[0].player.key==='fk-spec','Free-kick specialist did not outrank stronger raw non-specialist');
}
{
 const corner=p('corner-spec',{ovr:90,base:90,sa:['Corner Specialist']}),setpiece=p('setpiece',{ovr:105,base:105,sa:['Set Piece Taker']}),raw=p('raw-star',{ovr:120,base:120});
 const r=R.rankCorner(starters([raw,setpiece,corner]));ok(r[0].player.key==='corner-spec','Corner Specialist did not outrank Set Piece Taker/raw player');ok(r[1].player.key==='setpiece','Set Piece Taker did not outrank raw non-specialist');
}
// 1b. Set Piece Taker is a conservative second specialist tier for all three dead-ball families.
{
 const dedicatedPen=p('ded-pen',{ovr:90,base:90,sa:['Penalty Kick Specialist']}),combined=p('combined',{ovr:105,base:105,sa:['Set Piece Taker']}),raw=p('raw',{ovr:120,base:120});
 const rp=R.rankPenalty(starters([raw,combined,dedicatedPen]));ok(rp[0].player.key==='ded-pen'&&rp[1].player.key==='combined','Penalty hierarchy did not rank dedicated specialist > Set Piece Taker > raw');
 const dedicatedFk=p('ded-fk',{ovr:90,base:90,sa:['Free Kick Specialist']}),rf=R.rankFreeKick(starters([raw,combined,dedicatedFk]));ok(rf[0].player.key==='ded-fk'&&rf[1].player.key==='combined','Free-kick hierarchy did not rank dedicated specialist > Set Piece Taker > raw');
}
