const fs=require('fs'),vm=require('vm'),path=require('path');global.window=global;global.localStorage={getItem(){return null},setItem(){},removeItem(){},key(){return null},get length(){return 0}};
const ROOT=path.join(__dirname,'..');for(const f of ['optimizer-data.js','bible-data.js','data.js','strategy-data.js','strategy-logic.js','formation.js','tactics-engine.js'])vm.runInThisContext(fs.readFileSync(path.join(ROOT,'js',f),'utf8'),{filename:f});
const {Data:D,Formation:F,Tactics:T}=TE5,A=Object.keys(D.ATTRIBUTE_IDS);let failures=[],assertions=0;function ok(c,m){assertions++;if(!c)failures.push(m)}
function mk(k,r,v=100,ps=null){return{key:k,name:k,position:r,roles:[r],relatedRoles:[],ovr:v,skills:Object.fromEntries(A.map(a=>[a,v])),specialAbilities:[],playstyle:ps?{type:ps,level:3}:null}}
function xi(){return [['gk','GK'],['dl','DL'],['dc1','DC'],['dc2','DC'],['dr','DR'],['dmc','DMC'],['mc','MC'],['aml','AML'],['amc','AMC'],['amr','AMR'],['st','ST']].map(x=>mk(...x));}
function set(players,keys,skills,val){for(const p of players.filter(p=>keys.includes(p.key)))for(const a of skills)p.skills[a]=val;}
function run(players){const starters=F.assign(players,F.FORMATIONS.find(x=>x.id==='41131')).chosen;const r=T.recommendAuto(starters,{drainLimit:'High',drainProfile:T.DRAIN_PROFILE_LIVE});ok(!r.error,'Tactic calibration fixture returned error '+r.error);ok(r.drainProfile===T.DRAIN_PROFILE_LIVE,'Fixture did not use live-observed drain profile');ok(r.rawScore>=0&&r.rawScore<=17,'Live relative drain escaped 0..17');ok(r.drainClass==='Unclassified','Live drain class was guessed without thresholds');return r;}
// Technical midfield/attack: short circulation and buildup must be preferred when those clusters are overwhelmingly strong.
let p=xi();set(p,['dmc','mc','aml','amc','amr'],['Passing','Creativity','Dribbling'],170);let r=run(p);ok(r.values.passing==='short','Technical XI did not select Short Passing');ok(r.values.won==='buildup','Technical XI did not select Focus on Buildup');
// Symmetric elite wide service plus aerial target: both flanks + high crosses should be the semantic plan.
p=xi();set(p,['st'],['Heading','Strength','Positioning'],180);set(p,['aml','amr'],['Crossing','Speed','Dribbling'],170);r=run(p);ok(r.values.focus==='both','Symmetric elite wings did not select Both Flanks');ok(r.values.cross==='high','Aerial-wide XI did not select High Crosses');
// Pressing monster: use the aggressive recovery/pressing package under an unconstrained budget.
p=xi();set(p,p.map(x=>x.key),['Fitness','Aggression','Tackling','Bravery','Speed'],170);r=run(p);ok(r.values.pressing==='high','Pressing monster XI did not select High Press');ok(r.values.lost==='counterPress','Pressing monster XI did not select Counter Press');ok(r.values.tackling==='aggressive','Pressing monster XI did not select Aggressive Tackling');
// One-sided genuine superiority must route through that side.
p=xi();set(p,['dl','aml'],['Passing','Creativity','Dribbling','Crossing','Shooting','Finishing','Speed'],190);r=run(p);ok(r.values.focus==='left','Left-dominant XI did not select Left Flank');
p=xi();set(p,['dr','amr'],['Passing','Creativity','Dribbling','Crossing','Shooting','Finishing','Speed'],190);r=run(p);ok(r.values.focus==='right','Right-dominant XI did not select Right Flank');
// Tiny relevant perturbation must not create a plan flip.
const base=xi(),a=run(base);const tiny=xi();tiny.find(x=>x.key==='aml').skills.Dribbling+=0.001;const b=run(tiny);ok(JSON.stringify(a.values)===JSON.stringify(b.values),'A +0.001 relevant skill perturbation flipped the tactic plan');ok(Math.abs(a.decisionScore-b.decisionScore)<0.01,'A +0.001 perturbation created an excessive tactic-score jump');
console.log(JSON.stringify({assertions,failures},null,2));if(failures.length)process.exitCode=1;
